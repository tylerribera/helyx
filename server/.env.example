# ── Helyx Server Environment ──────────────────────────────────

# JWT secret key — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server port
PORT=3000

# Public site URL (used in email links)
FRONTEND_URL=https://helyx.us

# Resend (https://resend.com/api-keys) — leave blank in dev to log emails to console
RESEND_API_KEY=
EMAIL_FROM=Helyx <noreply@helyx.us>

# Cookie settings
COOKIE_DOMAIN=helyx.us
COOKIE_SECURE=true
