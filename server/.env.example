# ── Helyx Server Environment ──────────────────────────────────

# JWT secret key — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Server port
PORT=3000

# Frontend URL (for CORS & email links)
FRONTEND_URL=https://helyx.us

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Helyx <noreply@helyx.us>

# Cookie settings
COOKIE_DOMAIN=helyx.us
COOKIE_SECURE=true

# PayRam (crypto payments)
PAYRAM_API_URL=https://pay.helyx.us:8443
PAYRAM_API_KEY=
PAYRAM_WEBHOOK_SECRET=

# NMI Gateway (card payments — get from your gateway dashboard)
# Security Key: Settings > Security Keys > API Keys in NMI
# Tokenization Key: Settings > Security Keys > Collect.js Tokenization Key
NMI_SECURITY_KEY=
NMI_TOKENIZATION_KEY=
NMI_APPLE_PAY_ENABLED=
NMI_GOOGLE_PAY_ENABLED=
