# Copy to .env and fill in. Never commit .env.
#
# Supabase project credentials.
# The anon key is safe to ship in the client ONLY because Row Level Security
# is enabled on every table (see supabase/migrations). If RLS is ever disabled,
# this key becomes a full read/write credential. Do not disable RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical site origin, used for SEO tags and smart-banner links.
EXPO_PUBLIC_SITE_URL=https://helyx.us

# App Store ID for the iOS smart banner. Fill in once the app is registered.
EXPO_PUBLIC_IOS_APP_ID=
